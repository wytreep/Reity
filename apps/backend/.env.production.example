# ─── APP ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_PREFIX=api/v1
APP_URL=https://reity.app

# ─── DATABASE (Railway lo inyecta automáticamente) ─────────
DATABASE_URL=postgresql://user:pass@host:5432/db
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SYNC=false
DB_LOGGING=false

# ─── REDIS (Railway lo inyecta automáticamente) ────────────
REDIS_URL=redis://default:pass@host:6379
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_64_CHARS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=CAMBIAR_POR_STRING_ALEATORIO_64_CHARS
JWT_REFRESH_EXPIRATION=7d

# ─── CORS ──────────────────────────────────────────────────
ALLOWED_ORIGINS=https://reity.app,exp://

# ─── EMAIL (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
MAIL_FROM=Reity <no-reply@reity.app>

# ─── SENTRY ────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx

# ─── THROTTLE ──────────────────────────────────────────────
THROTTLE_TTL=900
THROTTLE_LIMIT=100
