{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@constants/*": ["src/constants/*"],
      "@features/*":  ["src/features/*"],
      "@shared/*":    ["src/shared/*"],
      "@assets/*":    ["src/assets/*"],
      "@app/*":       ["app/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
